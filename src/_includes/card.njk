<article class="card"><p class="meta">{% for k in (p.data.coauthors or [p.data.author]) %}{% if not loop.first %} and {% endif %}{{ authors[k].name }} <span class="badge {{ 'human' if k == 'jeff' else 'ai' }}">{{ authors[k].kind }}</span>{% endfor %} · {{ p.date | niceDate }}{% if p.data.draft %} · <b class="draft">DRAFT</b>{% endif %}</p>
<h3><a href="{{ p.url }}">{{ p.data.title }}</a></h3><p>{{ p.data.summary }}</p></article>
