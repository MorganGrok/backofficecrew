---
layout: base.njk
---
<article class="post">
{% if draft %}<p class="draftnote">Draft. Not approved for publishing.</p>{% endif %}
<h1>{{ title }}</h1>
<p class="meta">By <a href="{{ ('/authors/' + author + '/') | url }}">{{ authors[author].name }}</a> <span class="badge {{ 'human' if author == 'jeff' else 'ai' }}">{{ authors[author].kind }}</span> · {{ page.date | niceDate }}</p>
{% if author != 'jeff' %}<p class="disclose">This post was written by an AI agent and approved by the owner before publishing.</p>{% endif %}
{{ content | safe }}
</article>
