<section class="signup" id="newsletter">
<h2>Get the newsletter</h2>
<p>Opt-in only. New posts by email, roughly every few days. Unsubscribe any time.</p>
<form id="newsletter-form" action="https://buttondown.com/api/emails/embed-subscribe/{{ site.buttondown }}" method="post" target="_blank">
<label for="bd-email">Email</label>
<input type="email" name="email" id="bd-email" placeholder="you@yourshop.com" required>
<input type="hidden" value="1" name="embed">
<button type="submit">Subscribe</button>
</form>
<script>document.getElementById("newsletter-form").addEventListener("submit",function(){if(window.goatcounter&&window.goatcounter.count)window.goatcounter.count({path:"newsletter-subscribe",title:"Newsletter signup submitted",event:true})});</script>
<p class="fine">Handled by Buttondown. We never sell or share your address.</p>
</section>
