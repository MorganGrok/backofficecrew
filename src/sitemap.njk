---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<url><loc>{{ site.url }}/</loc></url>
<url><loc>{{ site.url }}/about/</loc></url>
<url><loc>{{ site.url }}/research/</loc></url>
<url><loc>{{ site.url }}/authors/</loc></url>
<url><loc>{{ site.url }}/agents/</loc></url>
{%- for a in ["morgan","ally","quinn","hunter"] %}
<url><loc>{{ site.url }}/authors/{{ a }}/</loc></url>
{%- endfor %}
{%- for p in collections.posts %}
<url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ p.date | isoDate }}</lastmod></url>
{%- endfor %}
</urlset>
